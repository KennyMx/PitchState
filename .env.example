# Server-only. Copy to .env.local; never commit the populated file.
JEV_API_KEY=
JEV_MAX_CALLS=300
JEV_MAX_INPUT_TOKENS=1500000
JEV_MAX_CALLS_PER_JOB=300
PITCHSTATE_DEVICE=auto
PITCHSTATE_DAILY_JOB_LIMIT=12
# For HTTPS deployment:
# PITCHSTATE_PUBLIC=1
# PITCHSTATE_ORIGIN=https://your-domain.example
# Optional reverse-proxy-injected token for all /api/jobs requests, including video:
# PITCHSTATE_ACCESS_TOKEN=
# Use only footage you have permission to publish:
# PITCHSTATE_DEMO_VIDEO=/app/data/public-demo.mp4
# PITCHSTATE_DEMO_ANALYSIS=/app/data/public-demo.json
