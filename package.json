{
  "name": "pitchstate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server": ".venv/bin/python -m uvicorn server.pitchstate.api:app --host 127.0.0.1 --port 8000",
    "test:server": ".venv/bin/python -m pytest server/tests -q",
    "format:server": ".venv/bin/ruff format server scripts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  }
}
